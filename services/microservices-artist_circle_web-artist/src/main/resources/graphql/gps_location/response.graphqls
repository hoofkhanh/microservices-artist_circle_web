type GpsLocationResponse{
	id: ID!
	artistId: ID!
	longitude: Float!
	latitude: Float!
	updatedAt: String!
}

type GpsLocationCreationResponse{
	gpsLocation: GpsLocationResponse!
}

type GpsLocationUpdateResponse {
	gpsLocation: GpsLocationResponse!
}

type GpsLocationCreationApiResponse{
	apiResponse: ApiResponse!
	data: GpsLocationCreationResponse
}

type GpsLocationUpdateApiResponse{
	apiResponse: ApiResponse!
	data: GpsLocationUpdateResponse
}