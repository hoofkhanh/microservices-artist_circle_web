input ProjectCreationRequest{
	project: ProjectRequest!
}

input ProjectUpdateRequest{
	project: ProjectRequest!
	id: ID!
}

input ProjectRequest{
	collaboratorIds: [ID!]
	musicGenreIds: [ID!]
	customCollaborators: String
	name: String!
	description: String!
	musicUrl: String!
	musicCloudinaryPublicId: String!
	imageUrl: String!
	imageCloudinaryPublicId: String!
	duration: Float!
	otherMusicGenreNames: String
}