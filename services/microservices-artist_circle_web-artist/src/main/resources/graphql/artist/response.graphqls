type RoleResponse{
	id: ID!
	name: String!
}

type ArtistResponse{
	id: ID!
	roles: [RoleResponse!]
	musicGenres: [MusicGenreResponse!]
	birthdate: String!
	gender: Boolean!
	artistName: String!
	residence: String!
	otherRoleNames: String
	otherMusicGenreNames: String
}

type ArtistProfileUpdateResponse{
	artist: ArtistResponse!
	avatarUrl: String!
	instagramUrl: String
	facebookUrl: String
	tiktokUrl: String
	description: String
}

type ArtistRegistrationResponse{
	artist: ArtistResponse!
}

type ArtistSearchDetailResponse{
	artist: ArtistResponse!
	avatarUrl: String
	avatarCloudinaryPublicId: String
	instagramUrl: String
	facebookUrl: String
	tiktokUrl: String
	description: String
	projects: [ProjectResponse!]
	gpsLocation: GpsLocationResponse!
}

type ArtistSearchResponse {
	id: Int!
	artistName: String!
	avatarUrl: String
	residence: String!
	distanceInMeters: Float
}

type ArtistRegistrationApiResponse{
	apiResponse: ApiResponse!
	data: ArtistRegistrationResponse
}

type ArtistProfileUpdateApiResponse{
	apiResponse: ApiResponse!
	data: ArtistProfileUpdateResponse
}

type ArtistSearchDetailApiResponse{
	apiResponse: ApiResponse!
	data: ArtistSearchDetailResponse
}

type ArtistGpsLocationResponse{
	longitude: Float!
	latitude: Float!
	artistId: ID!
}