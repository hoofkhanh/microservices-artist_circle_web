input ArtistRequest{
	roleIds: [ID!]
	musicGenreIds: [ID!]
	birthdate: String!
	gender: Boolean!
	artistName: String!
	residence: String!
	otherRoleNames: String
	otherMusicGenreNames: String
}

input ArtistProfileUpdateRequest{
	artist: ArtistRequest!
	avatarUpload: CloudinaryUploadRequest!
	instagramUrl: String
	facebookUrl: String
	tiktokUrl: String
	description: String
}

input ArtistRegistrationRequest{
	artist: ArtistRequest!
	userId: ID!
}