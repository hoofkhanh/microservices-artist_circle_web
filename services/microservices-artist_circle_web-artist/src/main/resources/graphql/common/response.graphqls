type MusicGenreResponse {
	id: ID!
	name: String!
}

type PageInfo{
	size: Int!
	number: Int!
	totalElements: Int!
	totalPages: Int!
}

enum StatusType{
	NO_ROLE_ASSIGNED
	NO_MUSIC_GENRE_ASSIGNED
	ARTIST_NOT_FOUND
	USER_NOT_FOUND
	USER_REGISTERED
}

type ApiResponse{
	success: Boolean!
	message: String!
	statusType: StatusType
}